#include <iostream>
#include <cmath>
#include <vector>
#include <string>

// Константы Единого Поля
const double AXIAL_TILT = 66.6;       // Предел гироскопической устойчивости (градусы)
const double BASE_FREQ = 333.0;       // Камертон-Частота (Hz)
const int HALF_SPHERE_CELLS = 144;    // Квантование полушария

enum Hemisphere { NORTH, SOUTH };
enum DiurnalCycle { DAY, NIGHT };

// Структура навигационной координаты ГЕОХРОН
struct FlightCoordinates {
    double latitude;
    double longitude;
    double seasonal_shift; // Сезонный сдвиг (от 0.0 до 1.0, привязка к Спасам/Новолетию)
};

// Базовый класс динамического волнового накопителя (LC-контур ячейки)
class WaveCellResonator {
public:
    int cell_id;
    Hemisphere hemisphere;
    double current_phase;
    double amplitude;

    WaveCellResonator(int id, Hemisphere hp) : cell_id(id), hemisphere(hp), current_phase(0.0), amplitude(0.0) {}

    // Фазовая автоподстройка частоты (ФАПЧ) под текущий космический луч
    void align_phase(DiurnalCycle cycle, double seasonal_factor, double harness_vector) {
        // Суточная инверсия (День/Ночь) как переворот знака (Антитезис)
        double diurnal_sign = (cycle == DAY) ? 1.0 : -1.0;
        
        // Полушарный сдвиг фаз (Север/Юг на противоположных полюсах управления)
        double sphere_offset = (hemisphere == NORTH) ? 0.0 : M_PI;

        // Единое универсальное уравнение для одной ячейки 144
        // Синус задает накачку (ВАЛ), Косинус - горизонтальное удержание опоры
        double k_lad = std::sin(harness_vector * seasonal_factor + sphere_offset);
        
        current_phase = BASE_FREQ * k_lad * diurnal_sign;
        amplitude = std::cos(current_phase * (AXIAL_TILT / 90.0));
    }

    void display_telemetry() const {
         std::cout << "Ячейка [" << (hemisphere == NORTH ? "СЕВЕР" : "ЮГ") << " #" << cell_id 
                   << "] -> Частота ФАПЧ: " << current_phase << " Hz | Амплитуда: " << amplitude << "\n";
    }
};

// Управляющий тактовый процессор системы (Сервер QUMRAN)
class QumranTactProcessor {
private:
    std::vector<WaveCellResonator> north_matrix;
    std::vector<WaveCellResonator> south_matrix;

public:
    QumranTactProcessor() {
        for(int i = 1; i <= HALF_SPHERE_CELLS; ++i) {
            north_matrix.emplace_back(i, NORTH);
            south_matrix.emplace_back(i, SOUTH);
        }
    }

    // Расчет и переключение всей распределительной сети 288 ячеек
    void execute_navigation_cycle(DiurnalCycle cycle, double year_progress) {
        std::cout << "\n--- СИНХРОНИЗАЦИЯ КОНТУРА: " << (cycle == DAY ? "ДЕНЬ" : "НОЧЬ") 
                  << " | СЕЗОННЫЙ ТАЙМИНГ: " << year_progress << " ---\n";

        // Расчет вектора 12 магистральных жгутов (12 колен)
        for(int i = 0; i < HALF_SPHERE_CELLS; ++i) {
            // Магистральный вектор как функция шага по сетке 12 колен
            double harness_vector = (i % 12) * (M_PI / 6.0); 

            // Одновременный пересчет встречных потоков Коры и Кары
            north_matrix[i].align_phase(cycle, year_progress, harness_vector);
            south_matrix[i].align_phase(cycle, year_progress, harness_vector);
        }
        
        // Вывод выборочной телеметрии реперных узлов для проверки когерентности (K_L)
        north_matrix[0].display_telemetry();  // Репер Рувим (Старт)
        north_matrix[143].display_telemetry(); // Репер Вениамин (Затвор)
        south_matrix[0].display_telemetry();  // Антиподальный узел
    }
};

int main() {
    QumranTactProcessor qumran_server;

    // Симуляция: Точка Новолетия / Сентябрьский цикл
    double autumn_equinox = 0.75; // Условный прогресс годового круга
    
    // Такт 1: Дневной полупериод
    qumran_server.execute_navigation_cycle(DAY, autumn_equinox);
    
    // Такт 2: Ночная инверсия и охлаждение контура
    qumran_server.execute_navigation_cycle(NIGHT, autumn_equinox);

    return 0;
}
